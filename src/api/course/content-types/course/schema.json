{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "pluginOptions": {},
      "type": "string",
      "unique": true,
      "required": true
    },
    "price": {
      "pluginOptions": {},
      "type": "decimal",
      "required": true
    },
    "duration": {
      "pluginOptions": {},
      "type": "decimal",
      "required": true,
      "min": 1
    },
    "startDate": {
      "pluginOptions": {},
      "type": "date",
      "required": true
    },
    "slug": {
      "pluginOptions": {},
      "type": "uid",
      "required": true,
      "targetField": "name"
    },
    "priceDisclaimer": {
      "pluginOptions": {},
      "type": "string"
    },
    "weekDays": {
      "pluginOptions": {},
      "type": "customField",
      "default": "[]",
      "options": [
        "seg.",
        "ter.",
        "qua.",
        "qui.",
        "sex.",
        "sáb.",
        "dom."
      ],
      "customField": "plugin::multi-select.multi-select",
      "required": true,
      "min": 1
    },
    "period": {
      "pluginOptions": {},
      "type": "enumeration",
      "enum": [
        "noturno",
        "a sua escolha"
      ],
      "required": true,
      "default": "noturno"
    },
    "category": {
      "pluginOptions": {},
      "type": "enumeration",
      "enum": [
        "bacharelado",
        "pós-graduação",
        "curso livre",
        "extensão"
      ],
      "required": true
    },
    "modality": {
      "pluginOptions": {},
      "type": "enumeration",
      "enum": [
        "presencial",
        "presencial/online",
        "online"
      ],
      "default": "presencial",
      "required": true
    },
    "durationUnit": {
      "pluginOptions": {},
      "type": "enumeration",
      "enum": [
        "dias",
        "meses",
        "anos"
      ],
      "required": true
    },
    "paymentRecurrence": {
      "type": "enumeration",
      "enum": [
        "mês",
        "único"
      ],
      "required": true,
      "default": "mês"
    },
    "startDateType": {
      "type": "enumeration",
      "enum": [
        "dia",
        "mês"
      ]
    },
    "classSchedule": {
      "type": "string"
    },
    "faculties": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faculty.faculty",
      "inversedBy": "courses"
    },
    "curriculum": {
      "type": "text"
    }
  }
}
